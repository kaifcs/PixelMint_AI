# ==========================================
# Server
# ==========================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://127.0.0.1:5173

# ==========================================
# Supabase
# ==========================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=pixelmint-ai

# ==========================================
# Remove.bg
# ==========================================
REMOVE_BG_API_KEY=your_remove_bg_api_key
REMOVE_BG_SIZE=auto

# ==========================================
# Application
# ==========================================
FREE_DAILY_LIMIT=2
PRO_DAILY_LIMIT=3

# ==========================================
# Razorpay
# ==========================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR
# Amount in paise (smallest INR subunit), NOT rupees — Razorpay's Orders API
# requires amount in the smallest currency subunit. 99900 paise = ₹999.00.
RAZORPAY_PRO_PLAN_AMOUNT=99900

# =========================
# Mail / SMTP
# =========================
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM_EMAIL=your-verified-email@example.com
MAIL_FROM_NAME=PixelMint AI
CONTACT_RECEIVER_EMAIL=your-support-email@example.com